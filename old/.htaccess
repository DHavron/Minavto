Options -Indexes
Options +FollowSymLinks
<IfModule mod_rewrite.c>
RewriteEngine on
RewriteBase /

RewriteCond %{HTTP_HOST} ^www\.minavto\.by [NC]
RewriteRule ^(.*)$ http://minavto\.by/$1 [R=301,L]
RewriteRule ^index\.php$ http://minavto\.by/ [R=301,L]

RewriteRule ^de/artikel.php?id=1 http://minavto\.by/de/metallbearbeitung/$1 [R=301,L]
RewriteRule ^ru/article_item.php?id=1 http://minavto\.by/ru/metallbearbeitung/$1 [R=301,L]
RewriteRule ^en/article_item.php?id=1 http://minavto\.by/en/metallbearbeitung/$1 [R=301,L]
RewriteRule ^pl/artykul.php?id=5 http://minavto\.by/pl/metallbearbeitung/$1 [R=301,L]
RewriteRule ^by/article_item.php?id=5 http://minavto\.by/by/metallbearbeitung/$1 [R=301,L]

RewriteRule ^de/artikel.php?id=2 http://minavto\.by/de/spritzgieben/$1 [R=301,L]
RewriteRule ^ru/article_item.php?id=2 http://minavto\.by/ru/spritzgieben/$1 [R=301,L]
RewriteRule ^en/article_item.php?id=2 http://minavto\.by/en/spritzgieben/$1 [R=301,L]
RewriteRule ^pl/artykul.php?id=15 http://minavto\.by/pl/spritzgieben/$1 [R=301,L]
RewriteRule ^by/article_item.php?id=15 http://minavto\.by/by/spritzgieben/$1 [R=301,L]

RewriteRule ^de/artikel.php?id=3 http://minavto\.by/de/dusenmontage/$1 [R=301,L]
RewriteRule ^ru/article_item.php?id=3 http://minavto\.by/ru/dusenmontage/$1 [R=301,L]
RewriteRule ^en/article_item.php?id=3 http://minavto\.by/en/dusenmontage/$1 [R=301,L]
RewriteRule ^pl/artykul.php?id=25 http://minavto\.by/pl/dusenmontage/$1 [R=301,L]
RewriteRule ^by/article_item.php?id=25 http://minavto\.by/by/dusenmontage/$1 [R=301,L]

RewriteRule ^de/artikel.php?id=4 http://minavto\.by/de/qualitatssicherung/$1 [R=301,L]
RewriteRule ^ru/article_item.php?id=4 http://minavto\.by/ru/qualitatssicherung/$1 [R=301,L]
RewriteRule ^en/article_item.php?id=4 http://minavto\.by/en/qualitatssicherung/$1 [R=301,L]
RewriteRule ^pl/artykul.php?id=35 http://minavto\.by/pl/qualitatssicherung/$1 [R=301,L]
RewriteRule ^by/article_item.php?id=35 http://minavto\.by/by/qualitatssicherung/$1 [R=301,L]

RewriteRule ^de/artikel.php?id=5 http://minavto.by/de/uber_uns/$1 [R=301,L]
RewriteRule ^ru/article_item.php?id=5 http://minavto.by/ru/uber_uns/$1 [R=301,L]
RewriteRule ^en/article_item.php?id=5 http://minavto.by/en/uber_uns/$1 [R=301,L]
RewriteRule ^pl/artykul.php?id=45 http://minavto.by/pl/uber_uns/$1 [R=301,L]
RewriteRule ^by/article_item.php?id=45 http://minavto.by/by/uber_uns/$1 [R=301,L]

RewriteRule ^de/suche.php http://minavto\.by/de/suche/$1 [R=301,L]
RewriteRule ^ru/search.php http://minavto\.by/ru/suche/$1 [R=301,L]
RewriteRule ^en/search.php http://minavto\.by/en/suche/$1 [R=301,L]
RewriteRule ^pl/poszukiwanie.php http://minavto\.by/pl/suche/$1 [R=301,L]
RewriteRule ^by/search.php http://minavto\.by/by/suche/$1 [R=301,L]

RewriteRule ^de/kontakte.php http://minavto\.by/de/kontakt/$1 [R=301,L]
RewriteRule ^ru/contact.php http://minavto\.by/ru/kontakt/$1 [R=301,L]
RewriteRule ^en/contacts.php http://minavto\.by/en/kontakt/$1 [R=301,L]
RewriteRule ^pl/kontakt.php http://minavto\.by/pl/kontakt/$1 [R=301,L]
RewriteRule ^by/contacts.php http://minavto\.by/by/kontakt/$1 [R=301,L]

RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^http://(www\.)?minavto\.by/.*$ [NC]
RewriteRule \.(jp?g|gif|js|png|css|mov|swf|dcr|exe|rar|avi|vob|zip)$ - [F]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)/$ ?$1 [L,QSA]
</IfModule>

# Bad Rquest
#ErrorDocument 400 /400.html
# Authorization Required
#ErrorDocument 401 /401.html
# Forbidden
#ErrorDocument 403 /403.html
# Not found
ErrorDocument 404 /404.php
#ErrorDocument 404 "Page not found"
# Method Not Allowed
#ErrorDocument 405 /405.html
# Request Timed Out
#ErrorDocument 408 /408.html
# Request URI Too Long
#ErrorDocument 414 /414.html
# Internal Server Error
#ErrorDocument 500 /500.html
# Not Implemented
#ErrorDocument 501 /501.html
# Bad Gateway 
#ErrorDocument 502 /502.html
# Service Unavailable 
#ErrorDocument 503 /503.html
# Gateway Timeout
#ErrorDocument 504 /504.html